# Referência das variáveis de ambiente que o backend precisa em produção.
# No Render, elas são cadastradas em Dashboard → seu serviço → Environment
# (não existe ".env" pra copiar — isso aqui é só documentação dos nomes).

# --- Banco de dados (Supabase > Project Settings > Database > Connection string > Connection pooling) ---
# Use o host do POOLER (Supavisor), não o "Direct connection" — o host direto
# só resolve em IPv6 e a maioria das plataformas free tier não tem saída IPv6.
DB_URL=jdbc:postgresql://<host-do-pooler>.pooler.supabase.com:6543/postgres
DB_USER=postgres.<referencia-do-projeto>
DB_PASSWORD=

# --- JWT ---
# Gere um valor aleatório com: openssl rand -base64 32
JWT_SECRET=

# --- CORS ---
# URL pública do frontend na Vercel, sem barra no final.
FRONTEND_URL=https://seu-projeto.vercel.app
