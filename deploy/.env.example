# Copie este arquivo pra ".env" na mesma pasta e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore da raiz).

# --- Banco de dados (Supabase > Project Settings > Database > Connection string) ---
DB_URL=jdbc:postgresql://<host-do-supabase>:5432/postgres
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
# Gere um valor aleatório com: openssl rand -base64 32
JWT_SECRET=

# --- CORS ---
# URL pública do frontend na Vercel, sem barra no final.
FRONTEND_URL=https://seu-projeto.vercel.app

# --- Domínio do backend ---
# Precisa apontar (registro DNS A) pro IP público da VM antes de subir o
# Caddy, senão a emissão automática do certificado HTTPS falha. Se ainda não
# tiver domínio próprio, dá pra usar o truque do nip.io: qualquer
# "<ip>.nip.io" resolve sozinho pro IP embutido no nome, sem precisar
# cadastrar nada (ex.: 203.0.113.10.nip.io).
BACKEND_DOMAIN=api.seudominio.com
